---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---

<div class="reveal mb-10 max-w-2xl">
  <p class="label">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 leading-relaxed text-muted">{lead}</p>}
</div>
