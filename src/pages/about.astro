---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site, intro, identities, education, creator, experience, skills, venture, socials, photo } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = `${base}${photo}`;
---

<Base title={`About — ${site.name}`} description={`About ${site.name}: engineer, builder and creator based in ${site.location}.`} page="about">
  <div class="about-wrap">
    <aside class="about-card">
      <div class="about-photo"><img src={img} alt={site.name} width="866" height="1316" /></div>
      <h2 class="about-name">{site.name}</h2>
      <p class="about-meta">{experience.role} · {experience.company}</p>
      <p class="about-meta">{site.location}</p>
      <ul class="about-soc">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}><SocialIcon name={s.icon} size={18} /></a></li>)}
        <li><a href={`mailto:${site.email}`} aria-label="Email" title="Email"><SocialIcon name="mail" size={18} /></a></li>
      </ul>
    </aside>

    <article class="about-main">
      <p class="label">About</p>
      <h1 class="about-h1">{site.name}</h1>
      <div class="about-intro">{intro.map((p) => <p>{p}</p>)}</div>

      <h2 class="about-h2">Three identities</h2>
      <div class="about-ids">
        {identities.map((i) => (
          <div class="about-box"><p class="label">{i.key}</p><p>{i.text}</p></div>
        ))}
      </div>

      <h2 class="about-h2">Work</h2>
      <div class="about-box">
        <p class="label">{experience.company}</p>
        <p class="about-role">{experience.role}</p>
        <p class="about-sub">{experience.journey.join(' → ')} · {experience.context}</p>
        <ul class="about-areas">{experience.areas.map((a) => <li>{a}</li>)}</ul>
      </div>

      <h2 class="about-h2">Tools</h2>
      <div class="about-skills">
        {skills.map((g) => (
          <div class="about-box"><p class="label">{g.group}</p><p class="about-tags">{g.items.map((i) => <span>{i}</span>)}</p></div>
        ))}
      </div>

      <h2 class="about-h2">Education</h2>
      <div class="about-box">
        <p class="about-role">{education.degree}</p>
        <p class="about-sub">{education.institution} · {education.years}</p>
        <p><strong>{education.achievement}.</strong></p>
        <ul class="about-areas one">{education.leadership.map((l) => <li>{l.role}, {l.org}</li>)}</ul>
      </div>

      <h2 class="about-h2">Ventures &amp; creating</h2>
      <div class="about-ids two">
        <div class="about-box"><p class="label">{venture.name}</p><p>{venture.blurb}</p></div>
        <div class="about-box"><p class="label">Creator</p><p>{creator.blurb}</p></div>
      </div>

      <div class="about-cta">
        <a class="btn" href={`${base}/projects/`}>See my projects</a>
        <a class="btn ghost" href={`mailto:${site.email}`}>Get in touch</a>
      </div>
    </article>
  </div>
</Base>

<style is:global>
  .about-wrap { max-width: 1180px; margin: 0 auto; padding: 64px var(--pad, 24px) 96px; display: grid; grid-template-columns: 320px 1fr; gap: 56px; align-items: start; }
  .about-card { position: sticky; top: 90px; padding: 22px; border: 1px solid var(--color-line); border-radius: 24px; background: linear-gradient(180deg, rgba(238,75,98,.1), rgba(15,15,20,.9) 55%); text-align: center; }
  .about-photo { aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 50% 40%, rgba(238,75,98,.55), rgba(90,10,30,.5) 60%, #0b0b10); }
  .about-photo img { width: 100%; height: 118%; object-fit: cover; object-position: top; }
  .about-name { margin-top: 18px; font-size: 40px; line-height: 1; }
  .about-meta { margin-top: 8px; font-size: 13.5px; color: var(--color-muted); }
  .about-soc { display: flex; gap: 10px; justify-content: center; margin-top: 18px; }
  .about-soc a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--color-line); color: var(--color-muted); transition: .2s; }
  .about-soc a:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .about-h1 { margin-top: 10px; font-size: clamp(56px, 8vw, 104px); line-height: .9; }
  .about-intro { margin-top: 28px; display: grid; gap: 16px; font-size: 17.5px; line-height: 1.7; color: var(--color-muted); max-width: 62ch; }
  .about-h2 { margin: 56px 0 18px; font-size: 38px; }
  .about-box { padding: 20px 22px; border: 1px solid var(--color-line); border-radius: 18px; background: var(--color-surface); color: var(--color-muted); line-height: 1.6; }
  .about-box .label { margin-bottom: 8px; }
  .about-ids { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .about-ids.two { grid-template-columns: repeat(2, 1fr); }
  .about-skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .about-role { font-family: var(--font-display); font-size: 30px; color: var(--color-ink); line-height: 1.1; }
  .about-sub { margin: 6px 0 12px; font-size: 14px; }
  .about-areas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px 22px; font-size: 14.5px; }
  .about-areas.one { grid-template-columns: 1fr; margin-top: 10px; }
  .about-areas li::before { content: '— '; color: var(--color-accent); }
  .about-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .about-tags span { padding: 4px 11px; border: 1px solid var(--color-line); border-radius: 999px; font-size: 13px; color: var(--color-ink); }
  .about-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; }
  .about-cta .btn { display: inline-flex; padding: 13px 22px; border-radius: 12px; background: var(--color-ink); color: #0a0a0d; font-weight: 600; font-size: 14px; }
  .about-cta .btn.ghost { background: transparent; color: var(--color-ink); border: 1px solid var(--color-line); }
  @media (max-width: 900px) {
    .about-wrap { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-top: 36px; }
    .about-wrap > * { min-width: 0; }
    .about-h1 { font-size: 64px; }
    .about-card { position: static; display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: 16px; text-align: left; align-items: center; padding: 16px; }
    .about-photo { grid-row: span 4; }
    .about-name { margin-top: 0; font-size: 32px; }
    .about-soc { justify-content: flex-start; margin-top: 10px; flex-wrap: wrap; gap: 8px; }
    .about-soc a { width: 34px; height: 34px; }
    .about-ids, .about-ids.two, .about-skills, .about-areas { grid-template-columns: minmax(0, 1fr); }
    .about-h2 { font-size: 32px; margin-top: 44px; }
  }
</style>
