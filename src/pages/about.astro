---
import Base from '../layouts/Base.astro';
import { site, intro, identities, education, creator } from '../config';
---

<Base title={`About — ${site.name}`} description={`About ${site.name}: engineer, builder and creator based in ${site.location}.`} page="about">
  <article class="mx-auto max-w-3xl px-5 pb-24 pt-16">
    <p class="label">About</p>
    <h1 class="mt-3 text-4xl font-semibold sm:text-6xl">{site.name}</h1>
    <p class="mt-3 text-muted">{site.location}</p>

    <div class="mt-10 space-y-5 text-lg leading-relaxed text-muted">
      {intro.map((p) => <p>{p}</p>)}
    </div>

    <h2 class="mt-16 text-2xl font-semibold">Three identities</h2>
    <dl class="mt-6 space-y-5">
      {identities.map((i) => (
        <div class="rounded-2xl border border-line bg-surface p-5">
          <dt class="label">{i.key}</dt>
          <dd class="mt-2 text-muted">{i.text}</dd>
        </div>
      ))}
    </dl>

    <h2 class="mt-16 text-2xl font-semibold">Education</h2>
    <p class="mt-4 text-muted">
      {education.degree}, {education.institution} ({education.years}). <strong class="text-ink">{education.achievement}.</strong>
    </p>
    <ul class="mt-4 space-y-2 text-muted">
      {education.leadership.map((l) => <li>{l.role}, {l.org}</li>)}
    </ul>

    <h2 class="mt-16 text-2xl font-semibold">Creating</h2>
    <p class="mt-4 text-muted">{creator.blurb}</p>
  </article>
</Base>
