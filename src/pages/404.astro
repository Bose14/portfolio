---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found — Bose A S" description="This page does not exist." page="notfound">
  <section class="mx-auto max-w-3xl px-5 py-32 text-center">
    <p class="label">404</p>
    <h1 class="mt-4 text-5xl font-semibold">Nothing here.</h1>
    <p class="mt-4 text-muted">The page you were looking for does not exist or has moved.</p>
    <a href={`${base}/`} class="mt-8 inline-block rounded-lg bg-accent px-5 py-3 text-sm font-medium text-bg">Back to home</a>
  </section>
</Base>
