---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { ArrowRight, Download } from '@lucide/astro';
import { site, socials, intro, identities, experience, skills, education, venture, creator } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const ventures = all.filter((p) => ['Software product', 'Concept', 'Hardware project', 'Independent product', 'Experiment'].includes(p.data.status));
---

<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pb-20 pt-16 sm:pt-24" data-assistant="hero" id="home">
    <p class="label">{site.name} · {site.location}</p>
    <h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[1.05] sm:text-7xl">
      I don't just write code.<br />
      <span class="text-accent">I build things that work.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">{site.tagline}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`${base}/projects/`} class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90">
        See my work <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a href="#contact" class="rounded-lg border border-line px-5 py-3 text-sm transition-colors hover:border-accent/60">Get in touch</a>
      {site.hasResume && (
        <a href={`${base}/resume.pdf`} class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-3 text-sm transition-colors hover:border-accent/60">
          <Download size={16} aria-hidden="true" /> Resume
        </a>
      )}
    </div>
    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      {identities.map((i) => (
        <li class="bg-surface p-6">
          <p class="label">{i.key}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{i.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Introduction -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="intro" id="about-intro">
    <SectionHead eyebrow="Introduction" title="An engineer who learns by building." />
    <div class="reveal max-w-2xl space-y-4 leading-relaxed text-muted">
      {intro.map((p) => <p>{p}</p>)}
    </div>
    <a href={`${base}/about/`} class="reveal mt-6 inline-flex items-center gap-2 text-sm text-accent">
      More about me <ArrowRight size={16} aria-hidden="true" />
    </a>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="projects" id="projects">
    <SectionHead
      eyebrow="Projects"
      title="Things I've built and explored."
      lead="Each project is labelled by what it actually is: a product, an experiment or a concept."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <ProjectCard slug={p.id} title={p.data.title} summary={p.data.summary} category={p.data.category} status={p.data.status} stack={p.data.stack} />
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="experience" id="experience">
    <SectionHead eyebrow="Experience" title="Backend and payments at Juspay." />
    <div class="reveal rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="text-2xl font-semibold">{experience.role}</h3>
          <p class="mt-1 text-muted">{experience.company} · {experience.location}</p>
        </div>
        <ol class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
          {experience.journey.map((j, i) => (
            <li class="flex items-center gap-2">
              <span class="rounded-full border border-line px-3 py-1">{j}</span>
              {i < experience.journey.length - 1 && <span aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>
      </div>
      <p class="mt-6 text-sm text-muted">{experience.context}</p>
      <ul class="mt-6 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
        {experience.areas.map((a) => (
          <li class="flex gap-2"><span class="text-accent" aria-hidden="true">›</span>{a}</li>
        ))}
      </ul>
      <p class="mt-6 border-t border-line pt-4 font-mono text-xs text-muted">{experience.note}</p>
    </div>
  </section>

  <!-- Skills -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="skills" id="skills">
    <SectionHead eyebrow="Technical skills" title="Tools I use and can explain." />
    <div class="grid gap-5 sm:grid-cols-2">
      {skills.map((g) => (
        <div class="reveal rounded-2xl border border-line bg-surface p-6">
          <p class="label">{g.group}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.items.map((i) => (
              <li class="rounded-md border border-line px-3 py-1 font-mono text-xs text-ink">{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Ventures -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="ventures" id="ventures">
    <SectionHead eyebrow="Ventures" title="Beyond Code – Building Businesses" lead={`${venture.name}: ${venture.blurb}`} />
    <ul class="divide-y divide-line rounded-2xl border border-line bg-surface">
      {ventures.map((p) => (
        <li>
          <a href={`${base}/projects/${p.id}/`} class="reveal flex flex-wrap items-center justify-between gap-3 px-6 py-5 transition-colors hover:bg-bg/60">
            <div>
              <p class="font-display text-lg font-semibold">{p.data.title}</p>
              <p class="text-sm text-muted">{p.data.category}</p>
            </div>
            <span class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{p.data.status}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Achievements -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="achievements" id="achievements">
    <SectionHead eyebrow="Education & achievements" title={education.achievement} lead={`${education.degree}, ${education.institution} (${education.years}).`} />
    <ul class="grid gap-5 md:grid-cols-3">
      {education.leadership.map((l) => (
        <li class="reveal rounded-2xl border border-line bg-surface p-6">
          <p class="label">Leadership</p>
          <p class="mt-3 font-display text-lg font-semibold">{l.role}</p>
          <p class="text-sm text-muted">{l.org}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Creator -->
  <section class="mx-auto max-w-6xl px-5 py-20" data-assistant="creator" id="creator">
    <SectionHead eyebrow="Beyond Code" title="Creator & community." lead={creator.blurb} />
    <ul class="reveal flex flex-wrap gap-2">
      {creator.topics.map((t) => <li class="rounded-full border border-line px-4 py-1.5 text-sm text-muted">{t}</li>)}
    </ul>
    <ul class="reveal mt-6 flex flex-wrap gap-3">
      {socials.filter((s) => s.icon === 'instagram').map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm transition-colors hover:border-accent/60">
            <SocialIcon name="instagram" size={16} /> {s.label.replace('Instagram · ', '')}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Contact -->
  <section class="mx-auto max-w-6xl px-5 py-24" data-assistant="contact" id="contact">
    <div class="reveal rounded-3xl border border-line bg-surface p-8 sm:p-14">
      <p class="label">Contact</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold sm:text-5xl">Let's build something, or just talk shop.</h2>
      <a href={`mailto:${site.email}`} class="mt-8 inline-block break-all font-mono text-lg text-accent underline underline-offset-4">{site.email}</a>
      <ul class="mt-8 flex flex-wrap gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-accent/60 hover:text-ink">
              <SocialIcon name={s.icon} size={16} /> {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
