---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { ArrowRight, ArrowUpRight, Download } from '@lucide/astro';
import '../styles/landing.css';
import { site, socials, intro, identities, experience, skills, education, venture, creator, companion, chatChips } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = `${base}/images/bose.webp`;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const nameChars = [...'BOSE A S'].map((c, i) => ({ c: c === ' ' ? ' ' : c, i }));
const statement = intro[0].split(' ');
const allSkills = skills.flatMap((g) => g.items);
const pad2 = (n: number) => String(n).padStart(2, '0');

const answers: Record<string, string> = {
  'Who is Bose?': `Bose A S is an engineer, product builder and entrepreneur based in ${site.location}. ${intro[2]}`,
  Experience: `${experience.role} at ${experience.company}. Journey: ${experience.journey.join(' → ')}. Areas: ${experience.areas.join('; ')}.`,
  Skills: skills.map((g) => `${g.group}: ${g.items.join(', ')}`).join('. ') + '.',
  Projects: projects.map((p) => `${p.data.title} (${p.data.status})`).join(', ') + '. Open any card for its case study.',
  Education: `${education.degree}, ${education.institution} (${education.years}). ${education.achievement}. Leadership: ${education.leadership.map((l) => `${l.role}, ${l.org}`).join('; ')}.`,
  Ventures: `${venture.name}: ${venture.blurb} Independent experiments: ${projects.map((p) => p.data.title).join(', ')}.`,
  Contact: `Email ${site.email}. GitHub, LinkedIn and Instagram links are in the contact section.`,
};
---

<Base title={site.title} description={site.description} page="home">
  <!-- Preloader -->
  <div class="preloader" id="preloader" role="status" aria-live="polite">
    <div class="pl-inner">
      <div class="pl-count"><span id="pl-num">0</span><small>%</small></div>
      <div class="pl-bar"><i id="pl-bar"></i></div>
      <div class="pl-label label"><span>Loading portfolio</span><span>{site.name}</span></div>
    </div>
  </div>

  <div class="fx fx-grain" aria-hidden="true"></div>
  <div class="fx fx-vignette" aria-hidden="true"></div>
  <div class="fx fx-spot" id="spot" aria-hidden="true"></div>
  <div class="fx fx-bars" aria-hidden="true"></div>

  <!-- The moving figure: one persistent cutout that travels the page -->
  <div class="figure" id="figure" aria-hidden="true">
    <div class="fig-rot" id="fig-rot">
      <div class="fig-ring2" id="fig-ring2"></div>
      <div class="fig-ring" id="fig-ring"></div>
      <div class="fig-glow" id="fig-glow"></div>
      <div class="fig-body" id="fig-body">
        <img class="fig-img body" id="fig-torso" src={photo} alt="" width="866" height="1416" decoding="async" />
        <img class="fig-img head" id="fig-head" src={photo} alt="" width="866" height="1416" decoding="async" />
      </div>
    </div>
  </div>
  <button type="button" class="fig-hit" id="fig-hit" aria-label="Hear what Bose has to say about this section"></button>
  <div class="bubble" id="bubble" role="status" aria-live="polite"><b class="label">Bose</b><span id="bubble-t"></span></div>

  <!-- HERO -->
  <section class="hero" id="home" data-co="home">
    <div class="hero-copy">
      <p class="eyebrow"><b>B</b><span class="label">Portfolio · 2026</span></p>
      <h1 class="hero-name" aria-label={site.name}>
        <span aria-hidden="true">{nameChars.map((n) => <span class="mask"><span class="c" style={`--i:${n.i};color:${n.col}`}>{n.c}</span></span>)}</span>
      </h1>
      <p class="hero-sub">Engineer · Builder · Creator</p>
      <p class="meta">
        <span class="pill">BACKEND</span>
        <span>{experience.role} at Juspay</span><i class="dot"></i>
        <span>Payments & eNACH</span><i class="dot"></i>
        <span>SaaS · AI · IoT</span>
      </p>
      <p class="lede">{site.tagline} I work on backend and payment systems at Juspay in {site.location}, and build SaaS, AI and IoT products on the side.</p>
      <div class="cta">
        <a class="btn btn-solid" href="#projects"><ArrowRight size={18} aria-hidden="true" /> Explore my work</a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
        {site.hasResume && <a class="btn btn-ghost" href={`${base}/resume.pdf`}><Download size={18} aria-hidden="true" /> Resume</a>}
        <button class="btn btn-round" type="button" id="hero-info" aria-label="Open the portfolio guide chat">i</button>
      </div>
    </div>
    <div class="chip chip-a" data-depth="14"><b>{experience.role}</b><span>Juspay Technologies</span></div>
    <div class="chip chip-b" data-depth="-10"><b>{venture.name}</b><span>Independent ventures</span></div>
    <div class="chip chip-c" data-depth="-18"><b>Java · Rails · Rust</b><span>Backend stack</span></div>
    <p class="scroll-hint"><i></i> Scroll</p>
  </section>

  <!-- ABOUT -->
  <section class="sec left" id="about" data-co="about">
    <div class="sec-in">
      <aside class="rail" aria-hidden="true"><div class="rail-in"><span class="rail-n">01</span><span class="rail-line"><i></i></span><span class="rail-t">About</span><span class="rail-s">Bengaluru, India</span></div></aside>
      <p class="label reveal">About</p>
      <p class="statement" id="statement" aria-label={intro[0]}>{statement.map((w) => <><span class="w" aria-hidden="true">{w}</span>{' '}</>)}</p>
      <div class="cols reveal">
        {intro.slice(1).map((p) => <p>{p}</p>)}
      </div>
      <ul class="ids reveal">
        {identities.map((i) => <li><h3>{i.key}</h3><p>{i.text}</p></li>)}
      </ul>
      <p class="reveal" style="margin-top:28px"><a class="btn btn-ghost" href={`${base}/about/`}>Full story <ArrowUpRight size={16} aria-hidden="true" /></a></p>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="sec right" id="experience" data-co="experience">
    <div class="sec-in">
      <aside class="rail" aria-hidden="true"><div class="rail-in"><span class="rail-n">02</span><span class="rail-line"><i></i></span><span class="rail-t">Experience</span><span class="rail-s">Juspay Technologies</span></div></aside>
      <p class="label reveal">Experience</p>
      <h2 class="h2 reveal">Backend & <em>payments</em></h2>
      <div class="card reveal" style="margin-top:36px">
        <h3 class="role">{experience.role}</h3>
        <p style="color:var(--color-muted);margin-top:6px">{experience.company} · {experience.location}</p>
        <div class="journey">
          {experience.journey.map((j, i) => (<><span class="s">{j}</span>{i < experience.journey.length - 1 && <span class="arr" aria-hidden="true">→</span>}</>))}
        </div>
        <p style="color:#c1bcc6">{experience.context}</p>
        <ul class="areas">{experience.areas.map((a) => <li>{a}</li>)}</ul>
        <p class="note">{experience.note}</p>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="sec" id="skills" data-co="skills" style="padding-left:0;padding-right:0">
    <div class="sec-in" style="padding:0 var(--pad)">
      <p class="label reveal">Technical skills</p>
      <h2 class="h2 reveal">Tools I <em>use</em></h2>
    </div>
    <div class="marq" aria-hidden="true" style="margin-top:36px">
      <div class="marq-row">{[...allSkills, ...allSkills].map((s) => <span>{s}</span>)}</div>
    </div>
    <div class="marq" aria-hidden="true">
      <div class="marq-row rev">{[...[...allSkills].reverse(), ...[...allSkills].reverse()].map((s) => <span>{s}</span>)}</div>
    </div>
    <div class="sec-in" style="padding:0 var(--pad)">
      <div class="groups">
        {skills.map((g) => (
          <div class="group reveal"><p class="label">{g.group}</p><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="sec" id="projects" data-co="projects">
    <div class="sec-in">
      <p class="label reveal">Projects</p>
      <h2 class="h2 reveal">Things I've <em>built</em></h2>
      <p class="lead reveal">Each project is labelled by what it actually is: a product, an experiment or a concept.</p>
      <div class="stack">
        {projects.map((p, i) => (
          <a class="pcard" style={`--i:${i}`} href={`${base}/projects/${p.id}/`}>
            <div class="pcard-l">
              <div>
                <span class="num" aria-hidden="true">{pad2(i + 1)}</span>
                <h3 style="margin-top:14px">{p.data.title}</h3>
              </div>
              <p class="sum">{p.data.summary}</p>
              <div class="row">
                <span class="tag hot">{p.data.status}</span>
                <span class="tag">{p.data.category}</span>
                <span class="go">Case study →</span>
              </div>
            </div>
            <div class="pcard-r" aria-hidden="true"><b>{pad2(i + 1)}</b></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VENTURES -->
  <section class="sec left" id="ventures" data-co="ventures">
    <div class="sec-in">
      <aside class="rail" aria-hidden="true"><div class="rail-in"><span class="rail-n">05</span><span class="rail-line"><i></i></span><span class="rail-t">Ventures</span><span class="rail-s">Azhizen Solutions</span></div></aside>
      <p class="label reveal">Ventures</p>
      <h2 class="h2 reveal">Beyond Code – <em>Building Businesses</em></h2>
      <p class="lead reveal"><b style="color:var(--color-ink)">{venture.name}</b>. {venture.blurb}</p>
      <div class="ventures reveal">
        {projects.map((p, i) => (
          <a class="vrow" href={`${base}/projects/${p.id}/`}>
            <span class="n">{pad2(i + 1)}</span>
            <div><h3>{p.data.title}</h3><small>{p.data.category}</small></div>
            <span class="tag">{p.data.status}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CREATOR -->
  <section class="sec right" id="creator" data-co="creator">
    <div class="sec-in">
      <aside class="rail" aria-hidden="true"><div class="rail-in"><span class="rail-n">06</span><span class="rail-line"><i></i></span><span class="rail-t">Beyond code</span><span class="rail-s">@bose_vlogz · @soul_of_roomez</span></div></aside>
      <p class="label reveal">Beyond Code</p>
      <h2 class="h2 reveal">Creator & <em>community</em></h2>
      <p class="lead reveal">{creator.blurb}</p>
      <ul class="topics reveal">{creator.topics.map((t) => <li>{t}</li>)}</ul>
      <ul class="socials reveal" style="margin-top:28px">
        {socials.filter((s) => s.icon === 'instagram').map((s) => (
          <li><a class="ig" href={s.href} target="_blank" rel="noopener"><SocialIcon name="instagram" size={16} /> {s.label.replace('Instagram · ', '')}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ACHIEVEMENTS -->
  <section class="sec left" id="achievements" data-co="achievements">
    <div class="sec-in">
      <aside class="rail" aria-hidden="true"><div class="rail-in"><span class="rail-n">07</span><span class="rail-line"><i></i></span><span class="rail-t">Achievements</span><span class="rail-s">KSRIET · 2021–2025</span></div></aside>
      <p class="label reveal">Education & achievements</p>
      <h2 class="h2 reveal">{education.achievement}</h2>
      <p class="lead reveal">{education.degree}, {education.institution} ({education.years})</p>
      <ul class="trio">
        {education.leadership.map((l) => (
          <li class="reveal"><p class="label">Leadership</p><h3>{l.role}</h3><p>{l.org}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="sec contact" id="contact" data-co="contact">
    <div class="sec-in" style="width:100%">
      <p class="label reveal">Contact</p>
      <h2 class="reveal">Let's build<br />something <em style="font-style:normal;color:var(--color-accent)">together.</em></h2>
      <a class="mail reveal" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="socials reveal">
        {socials.map((s) => (
          <li><a class="ig" href={s.href} target="_blank" rel="noopener"><SocialIcon name={s.icon} size={16} /> {s.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Guide chat -->
  <div class="buddy" id="buddy" data-action="idle">
    <canvas id="buddy-cv" aria-label="Animated 3D character of Bose. Click to make it jump, dance, wave or run."></canvas>
    <div class="buddy-ui">
      <button type="button" data-act="run">Run</button>
      <button type="button" data-act="jump">Jump</button>
      <button type="button" data-act="dance">Dance</button>
      <button type="button" data-act="wave">Wave</button>
      <button type="button" id="buddy-x" aria-label="Hide character">×</button>
    </div>
  </div>

  <button class="chat-fab" id="chat-fab" type="button" aria-expanded="false" aria-controls="chat"><i></i> Ask about Bose</button>
  <div class="chat" id="chat" hidden role="dialog" aria-label="Portfolio guide chat">
    <div class="chat-head"><div><b>Portfolio guide</b><small>Auto-replies from this site's content</small></div><button id="chat-x" type="button" aria-label="Close chat" style="color:var(--color-muted)">✕</button></div>
    <div class="chat-body" id="chat-body"></div>
    <div class="chat-chips" id="chat-chips">{chatChips.map((c) => <button type="button" data-q={c}>{c}</button>)}</div>
    <form class="chat-form" id="chat-form"><input id="chat-in" placeholder="Ask about Bose…" autocomplete="off" aria-label="Your question" /><button type="submit">Send</button></form>
  </div>

  <script type="application/json" id="site-data" set:html={JSON.stringify({ answers, email: site.email, messages: companion })}></script>
  <script is:inline>setTimeout(function(){var p=document.getElementById('preloader');if(p){p.classList.add('done');document.body.classList.remove('loading');document.body.classList.add('cinema-open');}},9000)</script>
  <script>
    import '../scripts/preloader';
    import '../scripts/companion';
    import '../scripts/chat';
    import '../scripts/buddy';
  </script>
</Base>
