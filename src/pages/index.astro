---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Character from '../components/Character.astro';
import SocialIcon from '../components/SocialIcon.astro';
import '../styles/world.css';
import { site, socials, intro, identities, experience, skills, education, venture, creator, levels, chatChips } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Hero headline split into words and characters for the staggered reveal.
const headline = [
  { text: "I don't just write code.", accent: false },
  { text: 'I build things that work.', accent: true },
];
let ci = 0;
const lines = headline.map((l) => ({
  accent: l.accent,
  words: l.text.split(' ').map((w) => ({ chars: [...w].map((c) => ({ c, i: ci++ })) })),
}));

// Skill tokens laid out along arcs. tx is in "vw units" scaled by --k in CSS.
const heights = [20, 34, 26, 40, 22, 36];
let tx = 30;
const skillLayout = skills.map((g) => {
  const signX = tx;
  tx += 12;
  const items = g.items.map((name, i) => {
    const t = { name, x: tx, h: heights[(i + 1) % heights.length], d: (i % 5) * 0.4 };
    tx += 11.5;
    return t;
  });
  tx += 8;
  return { group: g.group, signX, items };
});
const skillCount = skills.reduce((n, g) => n + g.items.length, 0);

const answers = {
  'Who is Bose?': `Bose A S is an engineer, product builder and entrepreneur based in ${site.location}. ${intro[2]}`,
  Experience: `${experience.role} at ${experience.company}. Journey: ${experience.journey.join(' → ')}. Areas: ${experience.areas.join('; ')}. Project context: ${experience.context}`,
  Skills: skills.map((g) => `${g.group}: ${g.items.join(', ')}`).join('. ') + '.',
  Projects: projects.map((p) => `${p.data.title} (${p.data.status})`).join(', ') + '. Open any portal for its case study.',
  Education: `${education.degree}, ${education.institution} (${education.years}). ${education.achievement}. Leadership: ${education.leadership.map((l) => `${l.role}, ${l.org}`).join('; ')}.`,
  Ventures: `${venture.name}: ${venture.blurb} Independent experiments: ${projects.map((p) => p.data.title).join(', ')}.`,
  Contact: `Email ${site.email}. GitHub, LinkedIn and Instagram links are at the finish line of the world.`,
};
const nav = levels.filter((l) => l.id !== 'skills');
---

<Base title={site.title} description={site.description} page="home" immersive>
  <!-- Preloader -->
  <div class="preloader" id="preloader" role="status" aria-live="polite">
    <div class="pl-inner">
      <div class="pl-count"><span id="pl-num">0</span><small>%</small></div>
      <div class="pl-bar"><i id="pl-bar"></i></div>
      <div class="pl-label label"><span>Loading portfolio</span><span>{site.name}</span></div>
    </div>
  </div>

  <!-- Film effects -->
  <div class="fx fx-grain" aria-hidden="true"></div>
  <div class="fx fx-vignette" aria-hidden="true"></div>
  <div class="fx fx-spot" id="spot" aria-hidden="true"></div>
  <div class="fx fx-bars" aria-hidden="true"></div>

  <!-- HUD -->
  <header class="hud">
    <a href={`${base}/`} class="hud-logo">{site.name}<b>.</b></a>
    <div class="hud-level" aria-hidden="true">
      <div class="hud-level-name"><b id="hud-name">Prologue</b><span id="hud-sub">Boot sequence</span></div>
      <div class="hud-track"><i id="hud-bar"></i></div>
    </div>
    <div class="hud-stats">
      <span class="hud-xp">XP <b id="hud-xp">0</b></span>
      <span class="hud-skills" style="color:var(--color-muted)"><b id="hud-sk" style="color:var(--color-ink)">0</b>/{skillCount} skills</span>
      <button class="hud-btn" id="snd" aria-pressed="false" aria-label="Toggle sound">Sound off</button>
      <button class="hud-btn" id="menu-btn" aria-expanded="false" aria-controls="hud-menu">Levels</button>
    </div>
    <nav class="hud-menu" id="hud-menu" aria-label="Levels" hidden>
      {nav.map((l, i) => <a href={`#${l.id}`} data-jump={l.id}>{l.nav}<span>{String(i).padStart(2, '0')}</span></a>)}
      <a href="#play" data-jump="play">Play<span>++</span></a>
    </nav>
  </header>

  <div class="banner" id="banner" aria-hidden="true"><span class="label" id="ban-k"></span><h2 id="ban-t"></h2></div>
  <div class="toast" id="toast" role="status"></div>

  <!-- THE WORLD -->
  <section class="world" id="world" data-world aria-label="Interactive portfolio world">
    <div class="stage">
      <div class="layer sky" data-depth="0.02" id="sky"><div class="moon"></div></div>
      <div class="layer" data-depth="0.07" id="far"></div>
      <div class="layer" data-depth="0.2" id="mid"></div>
      <div class="fog"></div>

      <div class="track" id="track">
        <!-- Prologue -->
        <section class="panel" id="home" data-level="home" style="width:105vw">
          <div class="panel-in hero-in">
            <p class="label">{site.name} · {site.location}</p>
            <h1 class="hero-title" aria-label={headline.map((h) => h.text).join(' ')}>
              {lines.map((l) => (
                <span class="line" aria-hidden="true">
                  {l.words.map((w) => (
                    <>
                      <span class="w">
                        {l.accent
                          ? <em>{w.chars.map((c) => <span class="c" style={`--i:${c.i}`}>{c.c}</span>)}</em>
                          : w.chars.map((c) => <span class="c" style={`--i:${c.i}`}>{c.c}</span>)}
                      </span>{' '}
                    </>
                  ))}
                  <br />
                </span>
              ))}
            </h1>
            <p class="hero-sub">{site.tagline}</p>
            <ul class="hero-id">
              {identities.map((i) => <li class="tag">{i.key}</li>)}
            </ul>
            <p class="hero-hint">
              <span><span class="key">→</span> or scroll to run</span>
              <span><span class="key">Space</span> jump</span>
              <span>Collect coins · squash bugs</span>
            </p>
          </div>
        </section>

        <!-- Level 1: Origin -->
        <section class="panel" id="about" data-level="about" data-fit>
          <div class="panel-in">
            <div class="glass story">
              <p class="label">Introduction</p>
              <h3>An engineer who learns by building.</h3>
              {intro.map((p) => <p>{p}</p>)}
            </div>
            <div class="glass edu">
              <p class="trophy" aria-hidden="true">🏆</p>
              <p class="label">Education & achievements</p>
              <h3>{education.achievement}</h3>
              <p>{education.degree}, {education.institution} ({education.years})</p>
              <ul class="quest" style="flex-direction:column;align-items:flex-start">
                {education.leadership.map((l) => <li><span class="step">{l.role}</span> <span style="color:var(--color-muted);font-size:13px">{l.org}</span></li>)}
              </ul>
            </div>
          </div>
        </section>

        <!-- Level 2: Experience -->
        <section class="panel" id="experience" data-level="experience" data-fit>
          <div class="panel-in">
            <div class="glass exp">
              <p class="label">Experience</p>
              <h3>{experience.role}</h3>
              <p>{experience.company} · {experience.location}</p>
              <div class="quest">
                {experience.journey.map((j, i) => (
                  <><span class="step">{j}</span>{i < experience.journey.length - 1 && <span aria-hidden="true" style="color:var(--color-muted)">→</span>}</>
                ))}
              </div>
              <p>{experience.context}</p>
              <ul class="xp-list">{experience.areas.map((a) => <li>{a}</li>)}</ul>
              <p style="margin-top:14px;font-family:var(--font-mono);font-size:11px">{experience.note}</p>
            </div>
          </div>
        </section>

        <!-- Side quest: Skills -->
        <section class="panel" id="skills" data-level="skills" style="width:calc(250vw * var(--k, 1))">
          <div class="panel-in skills-in" style="inset:0;position:absolute;left:0">
            {skillLayout.map((g) => (
              <>
                <span class="sign" style={`left:calc(${g.signX}vw * var(--k, 1));bottom:calc(var(--ground) + 4vh)`}>{g.group} ▸</span>
                {g.items.map((t) => (
                  <span class="token" data-token data-skill={t.name} style={`left:calc(${t.x}vw * var(--k, 1));bottom:calc(var(--ground) + ${t.h}vh + var(--char-h) * .35);--d:${t.d}s`}>{t.name}</span>
                ))}
              </>
            ))}
          </div>
        </section>

        <!-- Level 3: Projects -->
        <section class="panel" id="projects" data-level="projects" data-fit>
          <div class="panel-in portals-in">
            {projects.map((p, i) => (
              <a class="portal" href={`${base}/projects/${p.id}/`}>
                <span class="big" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="pn">PORTAL {String(i + 1).padStart(2, '0')} · {p.data.status}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                <span class="enter">Enter case study →</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Level 4: Ventures -->
        <section class="panel" id="ventures" data-level="ventures" data-fit>
          <div class="panel-in street-in">
            <div class="glass hq">
              <p class="label">Ventures</p>
              <h3>Beyond Code – Building Businesses</h3>
              <p><b style="color:var(--color-ink)">{venture.name}</b>. {venture.blurb}</p>
            </div>
            {projects.map((p) => (
              <a class="shop" href={`${base}/projects/${p.id}/`}>
                <div class="awning"></div>
                <p class="sn">{p.data.title}</p>
                <p class="sc">{p.data.category}</p>
                <span class="tag">{p.data.status}</span>
              </a>
            ))}
          </div>
        </section>

        <!-- Level 5: Creator -->
        <section class="panel" id="creator" data-level="creator" data-fit>
          <div class="panel-in">
            <div class="glass billboard">
              <p class="label">Beyond Code</p>
              <h3>Creator & community.</h3>
              <p>{creator.blurb}</p>
              <ul style="display:flex;flex-wrap:wrap;gap:8px;margin:16px 0">
                {creator.topics.map((t) => <li class="tag">{t}</li>)}
              </ul>
              <ul style="display:flex;flex-wrap:wrap;gap:10px">
                {socials.filter((s) => s.icon === 'instagram').map((s) => (
                  <li><a class="ig" href={s.href} target="_blank" rel="noopener"><SocialIcon name="instagram" size={16} /> {s.label.replace('Instagram · ', '')}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Final: Contact -->
        <section class="panel" id="contact" data-level="contact" data-fit="screen">
          <div class="panel-in finish-in">
            <p class="label">Final level · Contact</p>
            <h2>Let's build something, or just talk shop.</h2>
            <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
            <ul class="socials">
              {socials.map((s) => (
                <li><a class="ig" href={s.href} target="_blank" rel="noopener"><SocialIcon name={s.icon} size={16} /> {s.label}</a></li>
              ))}
            </ul>
            <p style="margin-top:22px"><a class="ig" href="#play" data-jump="play">Bonus level: Debug Run →</a></p>
          </div>
          <div class="flag" aria-hidden="true"></div>
        </section>
      </div>

      <div class="layer fore" id="fore" data-depth="1.35"></div>
      <div class="ground" id="ground"></div>

      <div class="player" id="player" role="button" tabindex="0" aria-label="Bo, your guide. Press to hear a tip.">
        <div class="flip"><Character /></div>
      </div>
      <div class="bubble" id="bubble" role="status" aria-live="polite"><b>Bo</b><span id="bubble-t"></span></div>
    </div>
  </section>

  <!-- BONUS LEVEL -->
  <section class="play" id="play" aria-label="Bonus level">
    <div class="play-in">
      <p class="label">Bonus level</p>
      <h2 style="font-size:clamp(32px,6vw,72px);font-weight:700;letter-spacing:-.04em;line-height:1;margin-top:10px">Debug Run</h2>
      <p style="color:var(--color-muted);margin-top:12px;max-width:560px">Production is on fire and the bugs are loose. Jump over them, grab the XP, and see how far you get. <span class="key">Space</span> or tap to jump.</p>
      <div class="game-wrap" id="game-wrap">
        <canvas id="game" width="1000" height="340" aria-label="Debug Run mini-game"></canvas>
        <div class="game-hud"><span>SCORE <b id="g-score" style="color:var(--color-ink)">0</b></span><span>BEST <b id="g-best" style="color:var(--gold)">0</b></span></div>
        <div class="game-msg" id="g-msg">
          <h3 id="g-title">Ready?</h3>
          <p id="g-sub">Press Space or tap to start</p>
          <button class="btn-play" id="g-btn" type="button">Play</button>
        </div>
      </div>
      <p style="margin-top:36px;font-size:13px;color:var(--color-muted)">© {new Date().getFullYear()} {site.name} · {site.location} · <a href={`${base}/about/`} style="color:var(--color-accent)">About</a> · <a href={`${base}/projects/`} style="color:var(--color-accent)">All projects</a></p>
    </div>
  </section>

  <!-- Ask Bo -->
  <button class="chat-fab" id="chat-fab" type="button" aria-expanded="false" aria-controls="chat"><i></i> Ask Bo</button>
  <div class="chat" id="chat" hidden role="dialog" aria-label="Chat with Bo">
    <div class="chat-head"><b>Bo · portfolio guide</b><button id="chat-x" type="button" aria-label="Close chat" style="color:var(--color-muted)">✕</button></div>
    <div class="chat-body" id="chat-body"></div>
    <div class="chat-chips" id="chat-chips">{chatChips.map((c) => <button type="button" data-q={c}>{c}</button>)}</div>
    <form class="chat-form" id="chat-form"><input id="chat-in" placeholder="Ask about Bose…" autocomplete="off" aria-label="Your question" /><button type="submit">Send</button></form>
  </div>

  <script type="application/json" id="game-data" set:html={JSON.stringify({ levels, answers, email: site.email, skillCount })}></script>
  <script>
    import '../scripts/preloader';
    import '../scripts/world';
    import '../scripts/game';
    import '../scripts/chat';
  </script>
</Base>
