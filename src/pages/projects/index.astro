---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`Projects — ${site.name}`} description="Products, experiments and concepts by Bose A S, each labelled by its real status." page="projects">
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-16">
    <p class="label">Projects</p>
    <h1 class="mt-3 text-4xl font-semibold sm:text-6xl">All projects</h1>
    <p class="mt-4 max-w-xl text-muted">Products, experiments and concepts, each labelled by what it actually is.</p>
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <ProjectCard slug={p.id} title={p.data.title} summary={p.data.summary} category={p.data.category} status={p.data.status} stack={p.data.stack} />
      ))}
    </div>
  </section>
</Base>
